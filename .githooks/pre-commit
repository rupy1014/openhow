#!/bin/bash
# pre-commit — 문서 참조 게이트 (omj)
#
# 없는 문서를 가리키는 링크는 조용히 쌓인다. 문서를 고치는 커밋에서 검사하고,
# 색인(docs/INDEX.md)을 같은 커밋에 넣는다. 도구가 없으면 조용히 통과한다 —
# 커밋을 막는 건 위반이지 도구 부재가 아니다.
#
# 활성화: git config core.hooksPath .githooks
# 규칙: ~/.claude/CLAUDE.md "문서 종류와 저널"

set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

DOCS_SH=""
for c in "$HOME/.claude/scripts/omj-docs.sh" .omj/_tools/omj-docs.sh; do
  [ -x "$c" ] && { DOCS_SH="$c"; break; }
done
[ -n "$DOCS_SH" ] || exit 0
[ -d docs ] || exit 0

STAGED="$(git diff --cached --name-only --diff-filter=ACM)"
printf '%s\n' "$STAGED" | grep -qE '^docs/.*\.md$' || exit 0

if ! OUT="$(bash "$DOCS_SH" links docs 2>&1)"; then
  echo "[pre-commit] 문서 링크가 없는 문서를 가리킵니다" >&2
  printf '%s\n' "$OUT" | grep '\[error\]' >&2
  echo "" >&2
  echo "  살아있는 경로로 고치거나, 미작성이면 링크를 텍스트로 내리세요." >&2
  exit 1
fi
bash "$DOCS_SH" index docs --write >/dev/null 2>&1 && git add docs/INDEX.md 2>/dev/null || true
